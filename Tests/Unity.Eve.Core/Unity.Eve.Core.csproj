<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the engine-free Unity source (Assets/UnityEve/Core) as a plain .NET Standard 2.1
       library, matching Unity 6's API surface and C# 9, so rules are testable in seconds without the editor. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Unity.Eve.Core</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/UnityEve/Core/**/*.cs" />
  </ItemGroup>
</Project>
